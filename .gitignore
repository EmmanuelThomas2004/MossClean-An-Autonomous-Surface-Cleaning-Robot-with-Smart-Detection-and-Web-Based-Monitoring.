# ─────────────────────────────────────────────
# MossClean — Git Ignore Rules
# ─────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Local databases
*.db
*.sqlite
*.sqlite3

# Moss detection output
moss_detections/
detections/
runs/

# YOLO / ML training artifacts
runs/
weights/
*.pt
*.pth
*.onnx

# Camera captures
captures/
snapshots/

# Raspberry Pi / hardware temporary files
*.pid
*.sock

# IDEs
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Build / distribution
build/
dist/
*.egg-info/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.coverage.*
